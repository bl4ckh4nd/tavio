# Tavio Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# ===========================================
# Convex Backend
# ===========================================
# Get these from your Convex dashboard after running `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-project-name
VITE_CONVEX_URL=https://your-project-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project-name.convex.site

# ===========================================
# Chat GIFs (Optional)
# ===========================================
# KLIPY API key (free at https://partner.klipy.com). It is built into the page, because KLIPY's
# terms require searches to come straight from the browser. Without it the GIF button is hidden.
# VITE_KLIPY_API_KEY=your_klipy_api_key

# ===========================================
# Application URLs
# ===========================================
# Development: http://localhost:3333
# Production: https://your-domain.com (MUST be HTTPS in production!)
VITE_BASE_URL=http://localhost:3333
BETTER_AUTH_URL=http://localhost:3333
SITE_URL=http://localhost:3333

# Convex backend auth issuer URL (set this in Convex via `npx convex env set`)
# npx convex env set CONVEX_SITE_URL="https://your-project-name.convex.site"
CONVEX_SITE_URL=https://your-project-name.convex.site

# ===========================================
# LiveKit Configuration (Required for video/audio)
# ===========================================
# Get these from https://cloud.livekit.io/
# IMPORTANT: Rotate these keys if they were ever exposed publicly!
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_HOST=wss://your-livekit-server.livekit.cloud
# Optional: address Convex uses for the Room Service API (breakouts, ending meetings)
# when it differs from LIVEKIT_HOST, e.g. a container network name. ws:// maps to http://.
# LIVEKIT_API_HOST=http://livekit:7880
# HTTP(S) API address used by Convex to start/stop egress jobs.
LIVEKIT_EGRESS_HOST=https://your-livekit-server.example.com
# Public Convex HTTP endpoint receiving authenticated LiveKit egress events.
LIVEKIT_EGRESS_WEBHOOK_URL=https://your-project-name.convex.site/livekit/egress
# Breakout transport: auto selects LiveKit Cloud native moves, otherwise reconnect.
LIVEKIT_BREAKOUT_MODE=auto

# ===========================================
# Recording Storage + Transcription
# ===========================================
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=your-recordings-bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ===========================================
# Meeting assistant (agent/ runs the worker; see agent/.env.example)
# ===========================================
# Must match the worker's name. Convex dispatches the assistant into a room with it.
ASSISTANT_AGENT_NAME=tavio-assistant

# ===========================================
# OAuth Providers (Optional - set via `npx convex env set`)
# ===========================================
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===========================================
# Email (Optional - set via `npx convex env set`)
# ===========================================
# RESEND_API_KEY=your_resend_api_key
# Sender address; its domain must be verified in Resend. Defaults to a placeholder that Resend rejects.
# RESEND_FROM_EMAIL=Tavio <no-reply@your-domain.com>

# ===========================================
# Billing (Optional - set via `npx convex env set`)
# ===========================================
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PRICE_PRO=your_stripe_price_id
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ===========================================
# Security Notes
# ===========================================
# - NEVER commit real API keys or secrets to version control
# - Use `npx convex env set KEY=value` for Convex-side secrets
# - Rotate any credentials that may have been exposed
# - Ensure HTTPS in production for all URLs
