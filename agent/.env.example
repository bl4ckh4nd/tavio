# The worker registers with LiveKit under this name; Convex dispatches it by the same name (ASSISTANT_AGENT_NAME there too).
LIVEKIT_URL=wss://your-livekit-server.example.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
ASSISTANT_AGENT_NAME=tavio-assistant

# Speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key
# Fallback when a person's client does not say which language the app is in (it normally does, as the participant attribute "lang").
ASSISTANT_LANGUAGE=de
# It leaves after this many minutes without a command, and after the second number in any case (defaults 20 and 120).
# ASSISTANT_IDLE_MINUTES=20
# ASSISTANT_MAX_MINUTES=120
# Optional, local debugging only: logs what the assistant heard and was given. Off by default, transcripts are never logged.
# ASSISTANT_LOG_COMMANDS=1

# The model, through any OpenAI-compatible endpoint with tool calls (OpenAI, OpenRouter, a LiteLLM gateway, ...).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name

# Only needed when Convex does not send its URL with the dispatch (self-hosted without CONVEX_CLOUD_URL).
# CONVEX_URL=https://your-deployment.convex.cloud
