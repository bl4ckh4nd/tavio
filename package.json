{
  "name": "tavio-meet",
  "private": true,
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-fonts.mjs && vite",
    "build": "node scripts/fetch-fonts.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:local:up": "bash scripts/e2e-local.sh",
    "e2e:local": "E2E_PORT=3334 E2E_CONVEX_URL=http://127.0.0.1:3210 E2E_CONVEX_SITE_URL=http://127.0.0.1:3211 playwright test --project=layout",
    "e2e:local:down": "if command -v podman >/dev/null 2>&1 && podman compose version >/dev/null 2>&1; then podman compose down; elif command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then docker compose down; else echo 'Podman Compose or Docker Compose is required.' >&2; exit 1; fi",
    "shots:landing": "node scripts/capture-landing-shots.mjs",
    "media:sync": "node scripts/sync-mediapipe-assets.mjs",
    "postinstall": "node scripts/sync-mediapipe-assets.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "i18n": "lingui extract && lingui compile",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@convex-dev/better-auth": "0.13.0",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/resend": "^0.2.10",
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "@lingui/core": "^6.10.1",
    "@lingui/react": "^6.10.1",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "@livekit/track-processors": "0.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/core": "3.32.1",
    "@tiptap/react": "3.32.1",
    "@tiptap/starter-kit": "3.32.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.21",
    "convex": "1.48.0",
    "dompurify": "^3.4.17",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "html2pdf.js": "0.14.0",
    "isomorphic-dompurify": "^4.6.0",
    "jsdom": "^30.1.3",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2",
    "lucide-react": "1.64.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "stripe": "^23.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lingui/cli": "^6.10.1",
    "@lingui/format-po": "^6.10.1",
    "@lingui/swc-plugin": "^6.7.1",
    "@lingui/vite-plugin": "^6.10.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.156.2"
  }
}
